# Skopíruj na .env a vyplň. .env sa do gitu nedostane.

# Token, ktorým sa hlási Opta. Rovnaká hodnota musí byť v skici.
# Vygeneruj napr.:  openssl rand -hex 24
DEVICE_TOKEN=zmen-ma

# Prihlásenie do dashboardu:
#   password – jedno spoločné heslo (nižšie)
#   none     – bez prihlásenia, LEN pre lokálnu sieť pri ladení
AUTH_MODE=password
ADMIN_PASSWORD=zmen-ma

# Podpisovanie session cookie. Keď sa zmení, všetci sa odhlásia.
# openssl rand -hex 32
SESSION_SECRET=zmen-ma

# Po koľkých ms bez hlásenia brať zariadenie ako offline
OFFLINE_AFTER_MS=15000
